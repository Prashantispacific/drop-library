# Optional custom Netlify Unfurl Server endpoint.
# Defaults to relative /.netlify/functions/unfurl when running on the web PWA.
# For standalone Android APK, specify your deployed Netlify app URL:
# VITE_UNFURL_ENDPOINT=https://your-app.netlify.app/.netlify/functions/unfurl
VITE_UNFURL_ENDPOINT=/.netlify/functions/unfurl
